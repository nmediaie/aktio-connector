#. Description of the plugin
#: aktio-connector.php
msgid "Schema.org, robots.txt and llms.txt for AI bots, Site Health and updates over REST — standalone or with Aktio."
msgstr "Schema.org, robots.txt i llms.txt dla botów AI, Site Health i aktualizacje przez REST — samodzielnie lub z Aktio."

#. Author of the plugin
#: aktio-connector.php
msgid "NM Media"
msgstr "NM Media"

#: includes/Admin/SettingsPage.php:44
msgid "Settings"
msgstr "Ustawienia"

#: includes/Admin/SettingsPage.php:54
