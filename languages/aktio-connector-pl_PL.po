msgstr "Brak uprawnień do tej operacji."

#: includes/Rest.php:142
msgid "The request body must be a JSON object."
msgstr "Body musi być obiektem JSON."

#. translators: %s: field name
#: includes/Rest.php:147
#, php-format
msgid "The %s field must be an object."
msgstr "Pole %s musi być obiektem."

#: includes/Rest.php:186
#: includes/Rest.php:211
msgid "The item field (string) is required."
msgstr "Pole item (tekst) jest wymagane."

#: includes/Rest.php:205
msgid "Invalid types for the item/enabled/core_level fields."
msgstr "Nieprawidłowe typy pól item/enabled/core_level."

#: includes/Rest.php:236
#: includes/Updates.php:467
msgid "type must be one of: core, plugin, theme."
msgstr "type musi być jednym z: core, plugin, theme."

#: includes/Schema/ProductSchema.php:471
msgid "Anonymous"
msgstr "Anonim"

#: includes/Updates.php:122
msgid "WordPress cannot write files on this server. Updating requires direct file access or FTP/SSH credentials in wp-config.php (FS_METHOD, FTP_HOST, FTP_USER, FTP_PASS)."
msgstr "WordPress nie może zapisywać plików na serwerze. Aktualizacja wymaga zapisu bezpośredniego albo danych FTP/SSH w wp-config.php (FS_METHOD, FTP_HOST, FTP_USER, FTP_PASS)."

#: includes/Updates.php:157
msgid "The update failed."
msgstr "Aktualizacja nie powiodła się."

#: includes/Updates.php:201
msgid "core_level must be one of: minor, all, off."
msgstr "core_level musi być jednym z: minor, all, off."

#: includes/Updates.php:218
msgid "The enabled field (true/false) is required."
msgstr "Pole enabled (true/false) jest wymagane."

#: includes/Updates.php:224
msgid "Automatic plugin updates are disabled on this site (by a filter or a configuration constant)."
msgstr "Automatyczne aktualizacje wtyczek są na tej stronie wyłączone (filtr lub stała w konfiguracji)."

#: includes/Updates.php:225
msgid "Automatic theme updates are disabled on this site (by a filter or a configuration constant)."
msgstr "Automatyczne aktualizacje motywów są na tej stronie wyłączone (filtr lub stała w konfiguracji)."

#: includes/Updates.php:436
msgid "Invalid plugin identifier."
msgstr "Nieprawidłowy identyfikator wtyczki."

#: includes/Updates.php:453
msgid "Invalid theme identifier."
msgstr "Nieprawidłowy identyfikator motywu."

#: includes/Updates.php:649
msgid "No such item was found on this site."
msgstr "Nie znaleziono takiego elementu na stronie."

#. translators: %s: SEO plugin name
#: includes/Admin/SettingsPage.php:403
#, php-format
msgid "Aktio Connector adds AI-bot rules to the robots.txt generated by %s."
msgstr "Aktio Connector dopisuje reguły botów AI do robots.txt generowanego przez %s."

#: includes/Admin/SettingsPage.php:253
msgid "Settings were not saved. Fix the following fields:"
msgstr "Ustawienia nie zostały zapisane. Popraw poniższe pola:"

#: includes/Admin/SettingsPage.php:267
msgid "Merchant"
msgstr "Dane sprzedawcy (Google)"

#: includes/Admin/SettingsPage.php:272
msgid "Used when they cannot be read from WooCommerce. You declare this data to Google — enter it in line with your store terms."
msgstr "Używane, gdy nie da się ich odczytać z WooCommerce. Deklarujesz te dane wobec Google — wpisz zgodne z regulaminem sklepu."

#: includes/Admin/SettingsPage.php:277
msgid "Default brand"
msgstr "Marka domyślna"

#: includes/Admin/SettingsPage.php:279
msgid "Used for products without their own brand. Empty means no default brand."
msgstr "Używana dla produktów bez własnej marki. Puste pole oznacza brak marki domyślnej."

#: includes/Admin/SettingsPage.php:283
msgid "Return policy"
msgstr "Polityka zwrotów"

#: includes/Admin/SettingsPage.php:285
msgid "Declare a return policy"
msgstr "Deklaruj politykę zwrotów"

#: includes/Admin/SettingsPage.php:285
msgid "Add the return policy to product offers"
msgstr "Dodaj politykę zwrotów do ofert produktów"

#: includes/Admin/SettingsPage.php:286
msgid "Return window (days)"
msgstr "Okres na zwrot (dni)"

#: includes/Admin/SettingsPage.php:286
msgid "0 means returns are not accepted."
msgstr "0 oznacza, że zwroty nie są przyjmowane."

#: includes/Admin/SettingsPage.php:289
msgid "Return costs"
msgstr "Koszty zwrotu"

#: includes/Admin/SettingsPage.php:295
msgid "Paid by the customer"
msgstr "Płaci klient"

#: includes/Admin/SettingsPage.php:296
msgid "Free returns"
msgstr "Bezpłatne zwroty"

#: includes/Admin/SettingsPage.php:300
msgid "Two-letter ISO country code, for example PL. Empty means no policy is emitted."
msgstr "Dwuliterowy kod kraju ISO, na przykład PL. Puste pole oznacza, że polityka nie jest dodawana."

#: includes/Admin/SettingsPage.php:303
msgid "Return method"
msgstr "Sposób zwrotu"

#: includes/Admin/SettingsPage.php:309
msgid "By mail"
msgstr "Pocztą"

#: includes/Admin/SettingsPage.php:310
msgid "In store"
msgstr "W sklepie"

#: includes/Admin/SettingsPage.php:311
msgid "By mail or in store"
msgstr "Pocztą lub w sklepie"

#: includes/Admin/SettingsPage.php:317
msgid "Fallback shipping"
msgstr "Wysyłka zastępcza"

#: includes/Admin/SettingsPage.php:319
msgid "Declare fallback shipping"
msgstr "Deklaruj wysyłkę zastępczą"

#: includes/Admin/SettingsPage.php:319
msgid "Add shipping details when WooCommerce zones do not provide them"
msgstr "Dodaj dane wysyłki, gdy strefy WooCommerce ich nie dostarczają"

#: includes/Admin/SettingsPage.php:320
msgid "Destination country"
msgstr "Kraj docelowy"

#. translators: %s: shop currency code, e.g. PLN
#: includes/Admin/SettingsPage.php:324
#, php-format
msgid "Shipping cost (%s)"
msgstr "Koszt wysyłki (%s)"

#: includes/Admin/SettingsPage.php:326
msgid "Amount in the shop currency, up to 2 decimal places, for example 12.50. 0.00 means free shipping."
msgstr "Kwota w walucie sklepu, do 2 miejsc po przecinku, na przykład 12.50. 0.00 oznacza bezpłatną wysyłkę."

#: includes/Admin/SettingsPage.php:328
msgid "Handling time (days)"
msgstr "Czas realizacji zamówienia (dni)"

#: includes/Admin/SettingsPage.php:328
msgid "From – to, 0 to 30 days."
msgstr "Od – do, 0 do 30 dni."

#: includes/Admin/SettingsPage.php:329
msgid "Delivery time (days)"
msgstr "Czas dostawy (dni)"

#: includes/Admin/SettingsPage.php:329
msgid "From – to, 0 to 60 days."
msgstr "Od – do, 0 do 60 dni."

#. translators: %s: field path, e.g. merchant.shipping
#: includes/Settings.php:205
#, php-format
msgid "%s must be an object."
msgstr "Pole %s musi być obiektem."

#. translators: %s: field path
#: includes/Settings.php:208
#, php-format
msgid "%s must be true or false."
msgstr "Pole %s musi mieć wartość true albo false."

#. translators: 1: field path, 2: minimum, 3: maximum
#: includes/Settings.php:211
#, php-format
msgid "%1$s must be an integer from %2$d to %3$d."
msgstr "Pole %1$s musi być liczbą całkowitą od %2$d do %3$d."

#. translators: 1: field path, 2: allowed values
#: includes/Settings.php:214
#, php-format
msgid "%1$s must be one of: %2$s."
msgstr "Pole %1$s musi mieć jedną z wartości: %2$s."

#. translators: %s: field path
#: includes/Settings.php:217
#, php-format
msgid "%s must be a two-letter uppercase ISO country code (for example PL) or an empty string."
msgstr "Pole %s musi być dwuliterowym kodem kraju ISO wielkimi literami (na przykład PL) albo pustym tekstem."

#. translators: %s: field path
#: includes/Settings.php:220
#, php-format
msgid "%s must be a non-negative decimal amount with at most 2 decimal places and up to 10 characters (for example 12.50)."
msgstr "Pole %s musi być nieujemną kwotą dziesiętną z co najwyżej 2 miejscami po przecinku i do 10 znaków (na przykład 12.50)."

#. translators: 1: field path, 2: minimum, 3: maximum
#: includes/Settings.php:223
#, php-format
msgid "%1$s must be a pair [min, max] of integers from %2$d to %3$d, with min not greater than max."
msgstr "Pole %1$s musi być parą [min, max] liczb całkowitych od %2$d do %3$d, przy czym min nie może być większe od max."

#. translators: 1: field path, 2: maximum length
#: includes/Settings.php:226
#, php-format
msgid "%1$s must be a string of at most %2$d characters."
msgstr "Pole %1$s musi być tekstem o długości najwyżej %2$d znaków."

#: includes/Admin/SettingsPage.php:269
msgid "Merchant fields work with a WooCommerce store."
msgstr "Pola sprzedawcy działają ze sklepem WooCommerce."

#. translators: %s: field path, e.g. merchant.retrun_policy
#: includes/Settings.php:202
#, php-format
msgid "%s is not a known field."
msgstr "Pole %s nie jest znanym polem."
